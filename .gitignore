# ==============================================================================
# Schedly Monorepo .gitignore
# Covers Root, Angular 22 Web Frontend, NestJS Backend, and Tooling
# ==============================================================================

# Compiled Output & Builds
dist/
build/
out-tsc/
bazel-out/
.angular/cache/
.sass-cache/
*.tsbuildinfo

# Dependencies & Package Managers
node_modules/
.pnpm-store/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Environment Variables & Secrets
.env
.env.*
!.env.example
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Testing & Code Coverage
coverage/
.nyc_output/
*.lcov
testem.log
.vitest/

# IDEs, Editors & Tooling
.idea/
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.history/

# Operating System & Runtime Artifacts
.DS_Store
Thumbs.db
*.swp
*.swo
*~
tmp/
temp/
.temp/
.tmp/
pids/
*.pid
*.seed
*.pid.lock
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Draft & Scratch Directories (excluding source reference if needed)
.draft/node_modules/
.draft/dist/
.draft/*.log

# Antigravity CLI / Internal Scratch Artifacts
.pi/
skills-lock.json
